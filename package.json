{
  "name": "@perry/postgres",
  "version": "0.2.0",
  "description": "Pure-TypeScript Postgres wire-protocol driver for Perry and Node.",
  "keywords": [
    "postgres",
    "postgresql",
    "pg",
    "driver",
    "perry",
    "typescript",
    "scram",
    "tls"
  ],
  "homepage": "https://github.com/PerryTS/postgres",
  "repository": {
    "type": "git",
    "url": "https://github.com/PerryTS/postgres.git"
  },
  "author": "Skelpo",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "perry": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["src/", "dist/", "README.md", "LICENSE", "CLAUDE.md"],
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:tls:node": "node --import tsx --test tests-node/tls-node-tests.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest",
    "tsx": "^4.21.0",
    "typescript": "^5.4"
  }
}
